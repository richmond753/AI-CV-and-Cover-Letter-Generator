# CareerAI Environment Variables
# Copy this file to .env and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=careerai
DB_CONNECTION_LIMIT=10

# JWT — use a long, random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Gemini API — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin(s) for CORS. Leave blank when the API serves the SPA from the
# same origin. Comma-separate multiple origins for split deployments.
FRONTEND_URL=

# Public app URL used in password-reset links
APP_URL=http://localhost:5000

# Freemium / cost controls
FREE_DAILY_GENERATIONS=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AI_RATE_LIMIT_MAX=30
UPLOAD_MAX_BYTES=2097152
